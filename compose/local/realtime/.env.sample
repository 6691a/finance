# kis-realtime 개발 환경변수. `cp .env.sample .env` 후 채운다. .env는 gitignore 대상이다.
# KIS 키·DB·Sentry는 여기가 아니라 config.yaml에 있다(FastAPI와 공유).

# 체크아웃 안에서 실행하므로 마운트 경로는 compose 기본값을 쓴다. 밖에서 돌릴 때만
# CODE_DIR(저장소 루트)와 CONFIG_FILE(config.yaml 경로)을 넣는다.
# 컨테이너 안 DB 주소는 host.docker.internal:15432여야 한다.

# NXT 체결 구독. 운영 계약 확인 전까지 기본 false.
KIS_ENABLE_NXT_WEBSOCKET=false

# 분 경계 뒤 몇 초를 기다렸다가 직전 분을 flush할지.
WS_FINALIZATION_DELAY_SECONDS=3

# 잠정 봉을 쓸 config.yaml의 DB alias. read_only: false여야 한다.
REALTIME_DB_ALIAS=default
