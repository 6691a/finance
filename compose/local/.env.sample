# Copy to compose/local/.env. Read by docker compose when starting the local
# stack and handed to the Grafana datasource provisioning files.
# Quote a password with single quotes so compose does not expand `$`.

# [배포] 저장 위치 5/5 - the database Grafana reads.
# The `news2` datasource, and with it the `환율 고시` dashboard. Leave these blank
# to use the local `db` container (db:5432 / news2 / news2). Point them somewhere
# else to graph another environment; nothing in the dashboard JSON changes.
# The dashboard also has a `데이터소스` dropdown for switching without a restart.
NEWS_DB_URL=
NEWS_DB_NAME=
NEWS_DB_USER=
NEWS_DB_PASSWORD=

# Read-only reporting database outside this project, kept for its historical rows.
# Optional: leave blank and the `finance` datasource is simply unusable. Nothing
# provisioned depends on it since `exchange_rate` moved to news2.
FINANCE_DB_URL=
FINANCE_DB_NAME=
FINANCE_DB_USER=
FINANCE_DB_PASSWORD=
