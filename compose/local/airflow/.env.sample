AIRFLOW_PROJ_DIR=./data/
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=pwd
# just fernet
FERNET_KEY=
AIRFLOW_UID=50000

# [배포] 저장 위치 2/5 — 수집 DAG가 실제로 쓰는 DB.
# `indicator_observation`, `source_record`, `exchange_rate`가 여기 있다.
# DAG 코드는 연결 이름(`news`)만 알고 접속 정보는 이 변수가 갖는다. 배포 대상을 바꿀 때
# 보통 여기 하나만 바꾸면 된다. 운영 Airflow는 이 변수 대신 Connection UI나 시크릿 백엔드에
# 같은 이름으로 등록한다. `host.docker.internal`은 컨테이너에서 호스트를 보는 로컬용 주소다.
AIRFLOW_CONN_FINANCE=postgresql://finance:finance@host.docker.internal:15432/finance

# https://fredaccount.stlouisfed.org/apikeys 에서 발급한 32자 키.
# 실제 값은 Git에서 제외된 compose/local/airflow/.env에만 넣는다.
FRED_API_KEY=

# https://ecos.bok.or.kr/api/#/AuthKeyApply 에서 발급한 한국은행 ECOS 인증키.
# 국내 시장금리(국고채·CD)를 받는 ecos_market_rate_daily가 쓴다. 이 키는 질의 문자열이
# 아니라 URL 경로에 들어가므로 URL을 로그에 남기지 않는다.
ECOS_API_KEY=

# https://opendart.fss.or.kr/uss/umt/EgovMberInsertView.do 에서 발급한 OpenDART 인증키.
# 삼성전자·SK하이닉스의 공시와 실적을 받는 dart_disclosure_intraday가 쓴다. 이 키는 질의
# 문자열에 들어가므로 URL을 예외 메시지와 로그에 남기지 않는다.
DART_API_KEY=

# https://www.data.go.kr 서비스키. 관세청 10일 단위 수출입 잠정치를 받는 kcs_trade_daily가 쓴다.
# **Decoding(원문) 값을 넣는다.** 포털이 Encoding·Decoding 두 형태로 주는데 인코딩된 값을 넣으면
# urlencode가 다시 인코딩해 `%2F`가 `%252F`가 되고 등록되지 않은 키로 거절된다.
# 데이터셋마다 활용신청이 따로다 — 넷(수출·수입 × 품목별·국가별) 전부 신청해야 태스크 넷이 산다.
# 이 키도 질의 문자열에 들어가므로 URL을 예외 메시지와 로그에 남기지 않는다.
KCS_SERVICE_KEY=

AIRFLOW_DAG_DIR=../../../

# DAG는 /opt/airflow/modules, /opt/airflow/utility를 import한다. Airflow가 sys.path에 넣는 건
# dags, plugins, config뿐이라 AIRFLOW_HOME 자체를 경로에 추가해야 한다.
PYTHONPATH=/opt/airflow

# 배치 트리거 시간대. cron과 start_date를 KST로 선언하고 UI도 KST로 본다.
# 컨테이너 시계, 로그, DB에 저장하는 시각은 UTC 그대로다.
AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Seoul

# 문서 태깅 DAG(document_assessment_hourly)이 쓰는 모델의 API 키.
#
# **어떤 모델을 부를지는 설정이 아니라 코드가 정한다.** `airflow/modules/llm.py`의
# `document_model()`이 `ChatOpenAI(model="gpt-5.6-luna", ...)`를 만들고, 키는 그 LangChain
# 클래스가 `OPENAI_API_KEY`라는 자기 이름으로 직접 읽는다. 모델이나 제공처를 바꾸려면 그
# 함수를 고치고, 그러면 여기 키 이름도 그 제공처 것으로 바뀐다.
#
# 비면 태깅 태스크가 모델을 만들 때 실패한다. 수집(document_ingestion_hourly)은 이 값과
# 무관하게 계속 돈다.
OPENAI_API_KEY=

# Slack 브리핑 선별(`modules/briefing/picks.py`)이 쓰는 모델의 API 키. `briefing_model()`이
# `ChatXAI(model="grok-4.6", ...)`를 만들고, 키는 `XAI_API_KEY`라는 자기 이름으로 읽는다.
XAI_API_KEY=

# 어느 시장의 눈으로 문서를 볼 것인가. 시스템 프롬프트 한 문단이 이 값으로 갈린다.
# 고를 수 있는 값은 셋뿐이고, 다른 값을 넣으면 태스크가 즉시 실패한다.
#
#   (비움)  = global 과 같다
#   global  = **기본.** 세계에서 일어난 일이 한국 시장에 닿는 경로까지 본다. 한국을 언급하지
#             않는 문서라도 경로가 뚜렷하면 관련성을 높게 본다. 켜져 있는 피드 아홉 중 여섯이
#             비한국이고 그것들을 모으는 이유가 이 전이 효과라 이게 기본이다.
#   korea   = 한국에서 직접 일어난 일만 본다. 해외 소식은 한국을 명시적으로 다룰 때만.
#             연준 성명 같은 문서가 대부분 0점을 받는다.
#   us      = 미국 시장의 눈. 연준 정책, 미국 지표, 미국 상장 기업이 대상이다.
#
# 값의 실제 문구는 `airflow/modules/assessment.py`의 `PERSPECTIVES`에 있다.
#
# **바꾸면 이미 평가한 문서가 전부 재평가 대상이 된다.** 관점이 `prompt_version`에 함께
# 저장되기 때문이다(`3/global`). 비용이 한 번 크게 튄다.
LLM_PERSPECTIVE=

# 한 실행에서 동시에 부를 문서 수. 1 이상의 정수이고 비우면 4다.
#
#   1     = 순차. 결과를 예전 실행과 비교할 때 이 값으로 둔다.
#   4     = 기본. 50건 배치가 대략 1/4 시간에 끝난다.
#   그 이상 = 제공처 rate limit(429)에 걸리면 태스크가 죽는다. 429는 재시도할 값어치가
#            있는 쪽으로 분류돼 Airflow가 10분 뒤 배치를 통째로 다시 돈다.
#
# 평가 결과는 이 값에 영향받지 않는다. 속도와 rate limit, 같은 시간에 쓰는 비용만 바뀐다.
LLM_MAX_CONCURRENCY=

# LangSmith 추적. 비우면 아무 것도 보내지 않고 호출 경로도 그대로다.
#
# **켜면 프롬프트 전문과 문서 제목·본문이 LangSmith(외부 SaaS)로 나간다.** 저장 위치가
# 문제가 되면 LANGSMITH_ENDPOINT로 EU 인스턴스나 셀프호스트를 가리킨다.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=

# Slack 브리핑 DAG 넷(slack_kr_market_briefing, slack_us_market_briefing,
# slack_document_briefing, slack_ops_briefing)이 쓴다.
#
# 봇 토큰이고 `chat:write` 스코프가 필요하다. 공개 채널은 `chat:write.public`이 있으면
# 초대 없이도 보내지지만, 비공개 채널은 봇을 초대해야 한다. 초대가 없어 거절당하면
# `not_in_channel`이고, 그건 재시도해도 같은 결과라 태스크가 즉시 실패한다.
SLACK_BOT_TOKEN=

# 리포트마다 채널이 다르다. 값은 채널 ID(`C...`)다.
#
# **채널 ID를 코드 상수로 두지 않는 이유가 이것이다.** 워크스페이스마다 다른 배포 설정이고,
# 상수로 두면 저장소가 특정 워크스페이스에 묶인다.
#
#   MARKET   = 한국장·미국장 브리핑이 함께 쓴다. 같은 주제를 시간대만 나눠 보내는 것이라
#              채널을 쪼개지 않는다.
#   DOCUMENT = 문서 평가 브리핑. 평가 0건이어도 보내므로 파이프라인 생존 신호를 겸한다.
#   OPS      = 수집 운영 현황. **나머지가 고장났음을 알려 줄 채널이라 시장 채널과 섞지 않는다.**
SLACK_CHANNEL_MARKET=
SLACK_CHANNEL_DOCUMENT=
SLACK_CHANNEL_OPS=
