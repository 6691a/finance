# 운영 Airflow 환경변수. `cp .env.sample .env` 후 채운다. .env는 gitignore 대상이다.
# 병렬도·파싱 주기 같은 튜닝 노브는 docker-compose.yaml의 environment가 정의한다.
# environment가 env_file을 덮어쓰므로 여기 두면 무효다.

AIRFLOW_UID=1026
AIRFLOW_GID=0
PYTHONPATH=/opt/airflow

# 외부 database 스택의 컨테이너 이름을 쓴다(같은 database 네트워크).
AIRFLOW__CELERY__BROKER_URL=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=
AIRFLOW__CELERY__RESULT_BACKEND=

AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Seoul

_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API_AUTH__JWT_ISSUER=
AIRFLOW__API__SECRET_KEY=

# Sentry. airflow.cfg가 아니라 여기서 켠다 — cfg는 저장소의 airflow/airflow.cfg를
# 마운트하므로 DSN을 cfg에 넣으면 커밋된다.
AIRFLOW__SENTRY__SENTRY_ON=
AIRFLOW__SENTRY__SENTRY_DSN=

XAI_API_KEY=
OPENAI_API_KEY=
# https://fredaccount.stlouisfed.org/apikeys 발급 키.
FRED_API_KEY=
# https://ecos.bok.or.kr/api/#/
ECOS_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
# NXT 종목 봉 REST 수집을 떼는 손잡이. 비우면 켜짐(KRX·NXT 둘 다)이고 false 면 KRX만 받는다.
# WebSocket 쪽 KIS_ENABLE_NXT_WEBSOCKET 과 기본값·허용 값이 같다. 모르는 값은 즉시 실패한다.
KIS_ENABLE_NXT_REST=
DART_API_KEY=

# 켜면 프롬프트와 문서 원문이 LangSmith로 나간다.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finance

LLM_PERSPECTIVE=global
LLM_MAX_CONCURRENCY=32

SLACK_BOT_TOKEN=
SLACK_CHANNEL_MARKET=
SLACK_CHANNEL_DOCUMENT=
SLACK_CHANNEL_OPS=
