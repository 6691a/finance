.idea/

.env
config.yaml

# 작업 중에만 쓰는 문서를 두는 곳이다. 리팩터링 감사, 에이전트가 만든 계획처럼
# 그때의 코드 상태를 찍은 것이라 며칠 뒤면 사실과 어긋난다. 추적하면 스테일 문서가
# 저장소에 쌓이고, 읽는 사람이 어느 쪽이 현재인지 가릴 수 없다.
# 남길 값어치가 생기면 `docs/` 아래로 옮겨 커밋한다.
docs/working/
docs/plans/

# 실행하면 앱키와 시세 응답이 출력에 남는다. 커밋하지 않는다.
notebooks/

compose/local/airflow/data/

# Claude Code가 만드는 작업용 워크트리. 저장소 안에 또 다른 저장소라 추적하지 않는다.
.claude/worktrees/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# 배포 Airflow가 마운트하는 디렉터리는 저장소에 남기고 내용만 무시한다.
# 디렉터리 자체가 없으면 새로 클론한 곳에서 바인드 마운트가 root 소유 빈 폴더를 만든다.
airflow/logs/*
!airflow/logs/.gitkeep
airflow/files/*
!airflow/files/.gitkeep
airflow/config/*
!airflow/config/.gitkeep
airflow/plugins/*
!airflow/plugins/.gitkeep

graphify-out/

# macOS
.DS_Store
