            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  $__timeGroupAlias(detected_at, $__interval),\n  count(*) AS \"수집\",\n  count(*) FILTER (WHERE assessed_at IS NOT NULL) AS \"평가 완료\"\nFROM document\nWHERE $__timeFilter(detected_at)\nGROUP BY 1\nORDER BY 1"
