      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "점수",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  d.published_at AS \"발행\",\n  COALESCE(s.name, d.source_slug) AS \"출처\",\n  d.title AS \"제목\",\n  d.value_score AS \"점수\",\n  d.direction AS \"방향\",\n  COALESCE((\n    SELECT string_agg(i.ticker, ', ' ORDER BY i.ticker)\n    FROM document_instrument i WHERE i.document_id = d.id\n  ), '') AS \"종목\",\n  COALESCE((\n    -- series_id 는 제공처 안에서만 고유하다. provider 를 함께 보여 준다.\n    SELECT string_agg(x.provider || ':' || x.series_id, ', ' ORDER BY x.provider, x.series_id)\n    FROM document_indicator x WHERE x.document_id = d.id\n  ), '') AS \"지표\",\n  COALESCE(d.assessment ->> 'reason', '') AS \"근거\",\n  d.canonical_url AS \"원문\"\nFROM document d\nLEFT JOIN document_source s ON s.slug = d.source_slug\nWHERE $__timeFilter(d.detected_at)\n  AND d.assessed_at IS NOT NULL\n  AND d.value_score >= $min_score\n  AND d.direction IN (${direction:sqlstring})\nORDER BY d.value_score DESC, d.published_at DESC NULLS LAST\nLIMIT 200"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "태그별 문서 수",
      "description": "어느 종목·지표에 문서가 몰리는지. 태그가 한쪽에만 쏠리면 후보 목록이 좁거나 프롬프트가 한 종목만 보고 있는 것이다. 지표는 provider 를 앞에 붙인다. series_id 는 제공처 안에서만 고유해서 그것만으로는 같은 이름이 겹칠 수 있다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "문서",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  '종목' AS \"구분\",\n  i.ticker AS \"태그\",\n  count(*) AS \"문서\",\n  round(avg(d.value_score), 2) AS \"평균 점수\",\n  count(*) FILTER (WHERE d.direction = 'positive') AS \"상승\",\n  count(*) FILTER (WHERE d.direction = 'negative') AS \"하락\"\nFROM document_instrument i\nJOIN document d ON d.id = i.document_id\nWHERE $__timeFilter(d.detected_at)\n  AND d.assessed_at IS NOT NULL\nGROUP BY 1, 2\nUNION ALL\nSELECT\n  '지표',\n  x.provider || ':' || x.series_id,\n  count(*),\n  round(avg(d.value_score), 2),\n  count(*) FILTER (WHERE d.direction = 'positive'),\n  count(*) FILTER (WHERE d.direction = 'negative')\nFROM document_indicator x\nJOIN document d ON d.id = x.document_id\nWHERE $__timeFilter(d.detected_at)\n  AND d.assessed_at IS NOT NULL\nGROUP BY 1, 2\nORDER BY 3 DESC"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "출처별 수집과 평가",
      "description": "출처마다 얼마나 들어오고 그 문서가 몇 점을 받는지. 평균 점수가 낮은 출처는 후보에서 빼는 것이 아니라 프롬프트나 수집 범위를 다시 볼 신호다. 문서는 점수로 버리지 않는다. '평가 대기'가 한 출처에만 쌓이면 그 출처의 문서가 길거나 형식이 달라 실패하는 것이다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
