      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "axisLabel": "문서"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "점수",
        "orientation": "auto",
        "showValue": "auto",
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  score.value::text AS \"점수\",\n  count(d.id) AS \"문서\"\nFROM generate_series(0, 8) AS score(value)\nLEFT JOIN document d\n  ON d.value_score = score.value\n AND d.assessed_at IS NOT NULL\n AND d.detected_at >= $__timeFrom()\n AND d.detected_at < $__timeTo()\n-- 별칭이 아니라 원래 열로 묶는다. `GROUP BY 1`은 텍스트로 캐스트한 별칭을 묶어\n-- ORDER BY score.value 가 집계 밖의 열이 된다.\nGROUP BY score.value\nORDER BY score.value"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "점수 높은 문서",
      "description": "선택 구간에서 점수가 높은 순서. 리포트가 고르는 것과 같은 순서라 여기서 위에 오는 문서가 쓸 만한지가 곧 이 파이프라인이 쓸 만한지다. '근거'는 모델이 쓴 한 문장이고 assessment JSONB 의 reason 이다. 종목·지표 태그는 마스터에 있는 값만 남은 결과다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
