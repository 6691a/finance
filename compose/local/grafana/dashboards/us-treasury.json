{
  "uid": "market-us-treasury",
  "title": "미국 국채 금리",
  "description": "indicator_observation 테이블의 FRED 국채 수익률(DGS3MO, DGS2, DGS10, DGS30)을 만기별로 조회한다.",
  "tags": [
    "market",
    "treasury",
    "fred"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-3M",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "series",
        "label": "만기",
        "description": "FRED 시계열. 표시는 한글 만기 이름이고 값은 시계열 ID다. 수집 대상은 modules.collectors.fred 의 TREASURY_SERIES 가 정한다.",
        "type": "custom",
        "query": "3개월물 (DGS3MO) : DGS3MO, 2년물 (DGS2) : DGS2, 10년물 (DGS10) : DGS10, 30년물 (DGS30) : DGS30",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "${series:text} 최신 금리",
      "description": "선택 구간의 마지막 관측값. 발표가 없는 날(휴장·결측)은 행이 없으므로 직전 영업일 값이 그대로 남는다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "repeat": "series",
      "repeatDirection": "h",
      "maxPerRow": 4,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  observed_at AS time,\n  value\nFROM (\n  SELECT\n    observation_date::timestamp AT TIME ZONE 'UTC' AS observed_at,\n    value\n  FROM indicator_observation\n  WHERE provider = 'fred'\n    AND series_id = ${series:sqlstring}\n) AS observations\nWHERE $__timeFilter(observed_at)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "만기별 금리 추이",
      "description": "관측일은 미국 영업일이다. 주말과 미국 공휴일에는 행이 없다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": null,
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  observed_at AS time,\n  value,\n  maturity AS metric\nFROM (\n  SELECT\n    observation_date::timestamp AT TIME ZONE 'UTC' AS observed_at,\n    value,\n    CASE series_id\n    WHEN 'DGS3MO' THEN '3개월물 (DGS3MO)'\n    WHEN 'DGS2' THEN '2년물 (DGS2)'\n    WHEN 'DGS10' THEN '10년물 (DGS10)'\n    WHEN 'DGS30' THEN '30년물 (DGS30)'\n    ELSE series_id\n  END AS maturity\n  FROM indicator_observation\n  WHERE provider = 'fred'\n    AND series_id IN (${series:sqlstring})\n) AS observations\nWHERE $__timeFilter(observed_at)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "장단기 금리차 (10Y - 3M)",
      "description": "0 아래로 내려가면 금리 역전이다. 두 시계열이 같은 날 모두 발표된 날만 그린다. `series` 변수와 무관하게 항상 DGS10과 DGS3MO를 쓴다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "line"
            },
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  observed_at AS time,\n  ten_year - three_month AS \"10Y-3M\"\nFROM (\n  SELECT\n    observation_date::timestamp AT TIME ZONE 'UTC' AS observed_at,\n    max(value) FILTER (WHERE series_id = 'DGS10') AS ten_year,\n    max(value) FILTER (WHERE series_id = 'DGS3MO') AS three_month\n  FROM indicator_observation\n  WHERE provider = 'fred'\n    AND series_id IN ('DGS10', 'DGS3MO')\n  GROUP BY 1\n) AS spread\nWHERE $__timeFilter(observed_at)\n  AND ten_year IS NOT NULL\n  AND three_month IS NOT NULL\nORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "만기별 최신 관측값과 수집 계보",
      "description": "시계열마다 가장 최근 행 하나. `source_record`를 조인해 그 값이 어느 수집 실행에서 왔는지 보여 준다. 수집 시각은 UTC다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "금리"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT DISTINCT ON (o.series_id)\n  CASE o.series_id\n    WHEN 'DGS3MO' THEN '3개월물 (DGS3MO)'\n    WHEN 'DGS2' THEN '2년물 (DGS2)'\n    WHEN 'DGS10' THEN '10년물 (DGS10)'\n    WHEN 'DGS30' THEN '30년물 (DGS30)'\n    ELSE o.series_id\n  END AS \"만기\",\n  o.observation_date AS \"관측일\",\n  o.value AS \"금리\",\n  o.unit AS \"단위\",\n  r.source AS \"제공처\",\n  r.completed_at AS \"수집 시각(UTC)\",\n  r.record_count AS \"수집 행 수\"\nFROM indicator_observation o\nJOIN source_record r ON r.id = o.source_record_id\nWHERE o.provider = 'fred'\n  AND o.series_id IN (${series:sqlstring})\nORDER BY o.series_id, o.observation_date DESC"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "수집 실행별 정규화 행 수",
      "description": "`source_record`에 남은 수집 계보. 실행마다 최근 7일을 다시 조회하므로 정상 실행이면 5~7행이 나온다. 0이 이어지면 발표가 없었거나 수집이 비어 돌아온 것이다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "points",
            "pointSize": 6,
            "lineWidth": 0,
            "fillOpacity": 0,
            "showPoints": "always",
            "spanNulls": false,
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  completed_at AS time,\n  record_count AS value,\n  CASE source_key\n    WHEN 'DGS3MO' THEN '3개월물 (DGS3MO)'\n    WHEN 'DGS2' THEN '2년물 (DGS2)'\n    WHEN 'DGS10' THEN '10년물 (DGS10)'\n    WHEN 'DGS30' THEN '30년물 (DGS30)'\n    ELSE source_key\n  END AS metric\nFROM source_record\nWHERE source = 'fred'\n  AND source_key IN (${series:sqlstring})\n  AND $__timeFilter(completed_at)\nORDER BY 1"
        }
      ]
    }
  ]
}
