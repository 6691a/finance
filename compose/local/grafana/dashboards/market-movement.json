{
  "uid": "market-movement",
    "title": "상승·보합·하락 종목 분포",
  "description": "코스피·코스닥에서 오른 종목이 몇이고 내린 종목이 몇인지 본다. **지수만 보면 소수 대형주가 끌어올린 장과 시장 전반이 오른 장을 구분할 수 없다.** 그 구분이 이 화면의 존재 이유다. market_movement_snapshot 을 읽고 지수 값은 quote_bar 에서 가져와 겹친다. 두 테이블의 symbol 값이 같아서 대응표 없이 조인된다. uid 는 바꾸지 않는다. 프로비저닝된 대시보드의 uid 를 바꾸면 Grafana 가 같은 파일로 두 번째 대시보드를 만들고 그 뒤로 갱신이 uid 충돌로 막힌다.",
  "tags": [
    "kis",
    "market",
    "intraday",
    "korea",
    "breadth"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-1d",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "name": "한국 정규장",
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "datasource": {
          "type": "postgres",
          "uid": "news2-postgres"
        },
        "target": {
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  (session_date + TIME '09:00') AT TIME ZONE 'Asia/Seoul' AS time,\n  (session_date + TIME '15:30') AT TIME ZONE 'Asia/Seoul' AS \"timeEnd\",\n  '한국 정규장' AS text\nFROM market_session\nWHERE market_code = 'KRX'\n  AND effective_open_day\n  AND session_date BETWEEN ($__timeFrom()::timestamptz AT TIME ZONE 'Asia/Seoul')::date\n                       AND ($__timeTo()::timestamptz AT TIME ZONE 'Asia/Seoul')::date"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "시장",
        "description": "분포를 고시하는 지수. 값이 quote_bar.symbol 과 같아서 지수 봉과 한 키로 조인된다. 코스피200은 코스피의 부분집합이라 분포 대상이 아니다.",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "news2-postgres"
        },
        "query": "SELECT DISTINCT symbol FROM market_movement_snapshot WHERE provider = 'kis' ORDER BY 1",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "${symbol:text} 상승 비율",
      "description": "선택 구간의 마지막 스냅샷에서 오른 종목의 비율. 분모는 상승+보합+하락이다. **상한가는 상승에 이미 포함돼 있으므로 다섯 값을 더하지 않는다**(실측). 50%를 넘으면 시장 전반이 오른 장이고, 지수는 올랐는데 이 값이 50% 아래면 소수 대형주가 끌어올린 장이다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "repeat": "symbol",
      "repeatDirection": "h",
      "maxPerRow": 4,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "text",
                "value": 45
              },
              {
                "color": "green",
                "value": 55
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  observed_at AS time,\n  -- 전체는 상승+보합+하락이다. 상·하한가는 그 안의 부분집합이라 더하면 이중 계산된다.\n  100.0 * rising_count / nullif(rising_count + unchanged_count + falling_count, 0) AS \"상승 비율\"\nFROM market_movement_snapshot\nWHERE provider = 'kis'\n  AND symbol = ${symbol:sqlstring}\n  AND $__timeFilter(observed_at)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "상승 비율 추이",
      "description": "두 시장의 상승 비율을 같은 축에서 본다. 코스피와 코스닥이 갈리는 날이 대형주 장세와 중소형주 장세를 가른다. 50% 선이 기준이다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "상승 비율(%)",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "text",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  observed_at AS time,\n  symbol AS metric,\n  100.0 * rising_count / nullif(rising_count + unchanged_count + falling_count, 0) AS value\nFROM market_movement_snapshot\nWHERE provider = 'kis'\n  AND symbol IN (${symbol:sqlstring})\n  AND $__timeFilter(observed_at)\nORDER BY 1, 2"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "${symbol:text} 지수 변동률 대 상승 비율",
      "description": "**이 화면의 핵심 패널이다.** 지수 변동률(왼쪽 축)과 상승 비율(오른쪽 축)이 갈리는 구간이 소수 종목이 지수를 끌고 간 구간이다. 지수는 `quote_bar`에서 온다. 두 테이블의 symbol 값이 같아 대응표 없이 조인된다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "repeat": "symbol",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "지수 변동률(%)"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "상승 비율"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "상승 비율(%)"
              },
              {
                "id": "custom.axisSoftMin",
                "value": 0
              },
              {
                "id": "custom.axisSoftMax",
                "value": 100
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  bar_at AS time,\n  100.0 * (close - previous_close) / nullif(previous_close, 0) AS \"지수 변동률\"\nFROM quote_bar\nWHERE provider = 'kis'\n  AND symbol = ${symbol:sqlstring}\n  AND $__timeFilter(bar_at)\nORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  observed_at AS time,\n  100.0 * rising_count / nullif(rising_count + unchanged_count + falling_count, 0) AS \"상승 비율\"\nFROM market_movement_snapshot\nWHERE provider = 'kis'\n  AND symbol = ${symbol:sqlstring}\n  AND $__timeFilter(observed_at)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "${symbol:text} 종목 수",
      "description": "상승·보합·하락 종목 수를 쌓아 본다. 세 값의 합이 그날 거래된 종목 수라 막대 높이가 거의 일정하고, 색의 비율만 움직인다. 상·하한가는 여기 따로 그리지 않는다. 이미 상승·하락 안에 들어 있다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "repeat": "symbol",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": "종목 수"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "상승"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "보합"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "하락"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT\n  observed_at AS time,\n  rising_count AS \"상승\",\n  unchanged_count AS \"보합\",\n  falling_count AS \"하락\"\nFROM market_movement_snapshot\nWHERE provider = 'kis'\n  AND symbol = ${symbol:sqlstring}\n  AND $__timeFilter(observed_at)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "최근 스냅샷",
      "description": "가장 최근 관측. 상·하한가는 상승·하락 안의 부분집합이라 따로 보여 준다. `관측 시각`은 제공처가 준 원천 시각이 아니라 응답을 받은 분이다. 개장 전과 마감 뒤에는 다섯 값이 0으로 리셋되므로 그 응답은 아예 저장하지 않는다.",
      "datasource": {
        "type": "postgres",
        "uid": "news2-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "상승 비율"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "시장",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "news2-postgres"
          },
          "rawSql": "SELECT DISTINCT ON (symbol)\n  symbol AS \"시장\",\n  observed_at AS \"관측 시각\",\n  rising_count + unchanged_count + falling_count AS \"거래 종목\",\n  rising_count AS \"상승\",\n  unchanged_count AS \"보합\",\n  falling_count AS \"하락\",\n  upper_limit_count AS \"상한가\",\n  lower_limit_count AS \"하한가\",\n  100.0 * rising_count / nullif(rising_count + unchanged_count + falling_count, 0) AS \"상승 비율\"\nFROM market_movement_snapshot\nWHERE provider = 'kis'\n  AND symbol IN (${symbol:sqlstring})\n  AND $__timeFilter(observed_at)\nORDER BY symbol, observed_at DESC"
        }
      ]
    }
  ]
}
